# Required: Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_EMBEDDING_DIMENSIONS=768
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# RETRIEVAL_TOP_K=4
# REVIEW_THRESHOLD=0.75
# STORAGE_DIR=./storage

# Supabase Auth Configuration (Backend)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_JWT_SECRET=your-jwt-secret-if-hs256
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-optional

# ============================================================================
# ALERT CENTER THIRD-PARTY NOTIFICATION PROVIDERS
# Note: If credentials are not set, Alert Center automatically runs in
# secure Mock/Sandbox mode so you can test OTP verification and deliveries safely.
# ============================================================================

# 1. Bangladesh SMS Gateway (SSL Wireless or Generic Gateway)
# Set SMS_PROVIDER to 'ssl', 'generic', or leave blank for 'mock'
# SMS_PROVIDER=ssl
# SSL Wireless Credentials (https://sslwireless.com):
# SSL_SMS_API_TOKEN=your_ssl_wireless_api_token
# SSL_SMS_SID=your_approved_sid_or_masking_name
# SSL_SMS_API_URL=https://smsplus.sslwireless.com/api/v3/send-sms
#
# OR Generic HTTP Gateway (Greenweb, Onnorokom, Alpha Net, BulkSMSBD):
# SMS_PROVIDER=generic
# SMS_API_URL=https://api.sms-provider.com/send
# SMS_API_KEY=your_sms_api_key
# SMS_SENDER_ID=LexGOV AI
# SMS_MASKING=false

# 2. WhatsApp Business (Meta WhatsApp Business Cloud API)
# Get credentials from Meta for Developers (https://developers.facebook.com):
# WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
# WHATSAPP_TOKEN=your_permanent_system_user_access_token
# WHATSAPP_APP_SECRET=your_meta_app_secret
# WHATSAPP_VERIFY_TOKEN=complianceos_wa_verify_token

# 3. Email Delivery (SMTP / Amazon SES / Brevo / Resend)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_your_api_key
# FROM_EMAIL=alerts@complianceos.com.bd

# 4. Optional Notification Channels (Disabled by default)
# ENABLE_TELEGRAM_ALERTS=false
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
#
# ENABLE_SLACK_ALERTS=false
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
#
# ENABLE_WEB_PUSH_ALERTS=false
# VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key


